rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー毎のデータ完全隔離：本人のみ読み取り・書き込み・削除を許可
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // サブコレクション（lives, nodes, logs など全深さ）のアクセス制御
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
